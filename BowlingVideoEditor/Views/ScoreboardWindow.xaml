<Window x:Class="BowlingVideoEditor.Views.ScoreboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎳 볼링 점수판" Height="620" Width="1050"
        Background="#FF1E1E1E" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <Style x:Key="ScoreCellBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MaxLength" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Player Name -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="선수 이름:" Foreground="White" VerticalAlignment="Center"
                       FontSize="14" Margin="0,0,8,0"/>
            <TextBox x:Name="PlayerNameBox" Width="200" Text="Player 1"
                     Background="#FF3E3E42" Foreground="White" BorderBrush="#FF555555"
                     FontSize="14" Padding="6,4" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Scoreboard (이미지 모양 그대로) -->
        <Border Grid.Row="1" BorderBrush="#FFAAAAAA" BorderThickness="2" Margin="0,0,0,16">
            <Grid x:Name="ScoreboardGrid">
                <!-- 11 columns: 10 frames + Total -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>
                <!-- 3 rows: header, throws, cumulative score -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>

                <!-- Frame Headers 1~10 + Total -->
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <TextBlock Text="1" Foreground="#FFCCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <TextBlock Text="2" Foreground="#FFCCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <TextBlock Text="3" Foreground="#FFCCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <TextBlock Text="4" Foreground="#FFCCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="4" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <TextBlock Text="5" Foreground="#FFCCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="5" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <TextBlock Text="6" Foreground="#FFCCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="6" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <TextBlock Text="7" Foreground="#FFCCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="7" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <TextBlock Text="8" Foreground="#FFCCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="8" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <TextBlock Text="9" Foreground="#FFCCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="9" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <TextBlock Text="10" Foreground="#FFCCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="10" BorderBrush="#FF888888" BorderThickness="0,0,0,1">
                    <TextBlock Text="Total" Foreground="#FFCCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                </Border>

                <!-- Frames 1~9: 투구 칸 (왼쪽 넓은칸 + 오른쪽 위 작은칸) -->
                <!-- Frame 1 -->
                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <Grid>
                        <TextBox x:Name="F1T1" Style="{StaticResource ScoreCellBox}" HorizontalAlignment="Left" Width="40" ToolTip="1프레임 1투구"/>
                        <Border BorderBrush="#FF888888" BorderThickness="1,0,0,1" HorizontalAlignment="Right" Width="32" VerticalAlignment="Top" Height="18">
                            <TextBox x:Name="F1T2" Style="{StaticResource ScoreCellBox}" FontSize="12" ToolTip="1프레임 2투구"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" BorderBrush="#FF888888" BorderThickness="0,0,1,0">
                    <TextBox x:Name="F1Score" Style="{StaticResource ScoreCellBox}" Foreground="#FF00CC6A" FontSize="16" ToolTip="1프레임 누적점수"/>
                </Border>

                <!-- Frame 2 -->
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <Grid>
                        <TextBox x:Name="F2T1" Style="{StaticResource ScoreCellBox}" HorizontalAlignment="Left" Width="40"/>
                        <Border BorderBrush="#FF888888" BorderThickness="1,0,0,1" HorizontalAlignment="Right" Width="32" VerticalAlignment="Top" Height="18">
                            <TextBox x:Name="F2T2" Style="{StaticResource ScoreCellBox}" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" BorderBrush="#FF888888" BorderThickness="0,0,1,0">
                    <TextBox x:Name="F2Score" Style="{StaticResource ScoreCellBox}" Foreground="#FF00CC6A" FontSize="16"/>
                </Border>

                <!-- Frame 3 -->
                <Border Grid.Row="1" Grid.Column="2" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <Grid>
                        <TextBox x:Name="F3T1" Style="{StaticResource ScoreCellBox}" HorizontalAlignment="Left" Width="40"/>
                        <Border BorderBrush="#FF888888" BorderThickness="1,0,0,1" HorizontalAlignment="Right" Width="32" VerticalAlignment="Top" Height="18">
                            <TextBox x:Name="F3T2" Style="{StaticResource ScoreCellBox}" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0">
                    <TextBox x:Name="F3Score" Style="{StaticResource ScoreCellBox}" Foreground="#FF00CC6A" FontSize="16"/>
                </Border>

                <!-- Frame 4 -->
                <Border Grid.Row="1" Grid.Column="3" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <Grid>
                        <TextBox x:Name="F4T1" Style="{StaticResource ScoreCellBox}" HorizontalAlignment="Left" Width="40"/>
                        <Border BorderBrush="#FF888888" BorderThickness="1,0,0,1" HorizontalAlignment="Right" Width="32" VerticalAlignment="Top" Height="18">
                            <TextBox x:Name="F4T2" Style="{StaticResource ScoreCellBox}" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="3" BorderBrush="#FF888888" BorderThickness="0,0,1,0">
                    <TextBox x:Name="F4Score" Style="{StaticResource ScoreCellBox}" Foreground="#FF00CC6A" FontSize="16"/>
                </Border>

                <!-- Frame 5 -->
                <Border Grid.Row="1" Grid.Column="4" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <Grid>
                        <TextBox x:Name="F5T1" Style="{StaticResource ScoreCellBox}" HorizontalAlignment="Left" Width="40"/>
                        <Border BorderBrush="#FF888888" BorderThickness="1,0,0,1" HorizontalAlignment="Right" Width="32" VerticalAlignment="Top" Height="18">
                            <TextBox x:Name="F5T2" Style="{StaticResource ScoreCellBox}" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="4" BorderBrush="#FF888888" BorderThickness="0,0,1,0">
                    <TextBox x:Name="F5Score" Style="{StaticResource ScoreCellBox}" Foreground="#FF00CC6A" FontSize="16"/>
                </Border>

                <!-- Frame 6 -->
                <Border Grid.Row="1" Grid.Column="5" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <Grid>
                        <TextBox x:Name="F6T1" Style="{StaticResource ScoreCellBox}" HorizontalAlignment="Left" Width="40"/>
                        <Border BorderBrush="#FF888888" BorderThickness="1,0,0,1" HorizontalAlignment="Right" Width="32" VerticalAlignment="Top" Height="18">
                            <TextBox x:Name="F6T2" Style="{StaticResource ScoreCellBox}" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="5" BorderBrush="#FF888888" BorderThickness="0,0,1,0">
                    <TextBox x:Name="F6Score" Style="{StaticResource ScoreCellBox}" Foreground="#FF00CC6A" FontSize="16"/>
                </Border>

                <!-- Frame 7 -->
                <Border Grid.Row="1" Grid.Column="6" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <Grid>
                        <TextBox x:Name="F7T1" Style="{StaticResource ScoreCellBox}" HorizontalAlignment="Left" Width="40"/>
                        <Border BorderBrush="#FF888888" BorderThickness="1,0,0,1" HorizontalAlignment="Right" Width="32" VerticalAlignment="Top" Height="18">
                            <TextBox x:Name="F7T2" Style="{StaticResource ScoreCellBox}" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="6" BorderBrush="#FF888888" BorderThickness="0,0,1,0">
                    <TextBox x:Name="F7Score" Style="{StaticResource ScoreCellBox}" Foreground="#FF00CC6A" FontSize="16"/>
                </Border>

                <!-- Frame 8 -->
                <Border Grid.Row="1" Grid.Column="7" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <Grid>
                        <TextBox x:Name="F8T1" Style="{StaticResource ScoreCellBox}" HorizontalAlignment="Left" Width="40"/>
                        <Border BorderBrush="#FF888888" BorderThickness="1,0,0,1" HorizontalAlignment="Right" Width="32" VerticalAlignment="Top" Height="18">
                            <TextBox x:Name="F8T2" Style="{StaticResource ScoreCellBox}" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="7" BorderBrush="#FF888888" BorderThickness="0,0,1,0">
                    <TextBox x:Name="F8Score" Style="{StaticResource ScoreCellBox}" Foreground="#FF00CC6A" FontSize="16"/>
                </Border>

                <!-- Frame 9 -->
                <Border Grid.Row="1" Grid.Column="8" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <Grid>
                        <TextBox x:Name="F9T1" Style="{StaticResource ScoreCellBox}" HorizontalAlignment="Left" Width="40"/>
                        <Border BorderBrush="#FF888888" BorderThickness="1,0,0,1" HorizontalAlignment="Right" Width="32" VerticalAlignment="Top" Height="18">
                            <TextBox x:Name="F9T2" Style="{StaticResource ScoreCellBox}" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="8" BorderBrush="#FF888888" BorderThickness="0,0,1,0">
                    <TextBox x:Name="F9Score" Style="{StaticResource ScoreCellBox}" Foreground="#FF00CC6A" FontSize="16"/>
                </Border>

                <!-- Frame 10 (3투구) -->
                <Border Grid.Row="1" Grid.Column="9" BorderBrush="#FF888888" BorderThickness="0,0,1,1">
                    <Grid>
                        <TextBox x:Name="F10T1" Style="{StaticResource ScoreCellBox}" HorizontalAlignment="Left" Width="30"/>
                        <Border BorderBrush="#FF888888" BorderThickness="1,0,0,1" HorizontalAlignment="Center" Width="30" VerticalAlignment="Top" Height="18" Margin="20,0,0,0">
                            <TextBox x:Name="F10T2" Style="{StaticResource ScoreCellBox}" FontSize="12"/>
                        </Border>
                        <Border BorderBrush="#FF888888" BorderThickness="1,0,0,1" HorizontalAlignment="Right" Width="30" VerticalAlignment="Top" Height="18">
                            <TextBox x:Name="F10T3" Style="{StaticResource ScoreCellBox}" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Grid.Column="9" BorderBrush="#FF888888" BorderThickness="0,0,1,0">
                    <TextBox x:Name="F10Score" Style="{StaticResource ScoreCellBox}" Foreground="#FF00CC6A" FontSize="16"/>
                </Border>

                <!-- Total -->
                <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="10">
                    <TextBlock x:Name="TotalScoreText" Text="0" Foreground="#FF00CC6A"
                               FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 시간대별 점수 입력 섹션 -->
        <TextBlock Grid.Row="2" Text="⏱ 시간대별 프레임 점수 입력" Foreground="#FF007ACC"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 추가 버튼 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="시간 (hh:mm:ss):" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="EntryTimeBox" Width="80" Text="00:00:00"
                         Background="#FF3E3E42" Foreground="White" BorderBrush="#FF555555"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <TextBlock Text="프레임:" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox x:Name="EntryFrameCombo" Width="55" SelectedIndex="0"
                          Background="#FF3E3E42" Foreground="White">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="9"/>
                    <ComboBoxItem Content="10"/>
                </ComboBox>
                <TextBlock Text="1투:" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox x:Name="EntryT1Box" Width="35" Background="#FF3E3E42" Foreground="White"
                         BorderBrush="#FF555555" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <TextBlock Text="2투:" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox x:Name="EntryT2Box" Width="35" Background="#FF3E3E42" Foreground="White"
                         BorderBrush="#FF555555" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <TextBlock Text="3투:" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox x:Name="EntryT3Box" Width="35" Background="#FF3E3E42" Foreground="White"
                         BorderBrush="#FF555555" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <TextBlock Text="누적:" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox x:Name="EntryCumBox" Width="45" Background="#FF3E3E42" Foreground="White"
                         BorderBrush="#FF555555" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="➕ 추가" Click="AddEntry_Click" Margin="12,0,0,0"/>
                <Button Content="🗑 삭제" Click="RemoveEntry_Click" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- 시간대별 목록 -->
            <DataGrid Grid.Row="1" x:Name="TimelineGrid" AutoGenerateColumns="False"
                      Background="#FF252526" Foreground="White" BorderBrush="#FF555555"
                      RowBackground="#FF2D2D30" AlternatingRowBackground="#FF333337"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF555555"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF3E3E42"/>
                        <Setter Property="Foreground" Value="#FFCCCCCC"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderBrush" Value="#FF555555"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="시간" Binding="{Binding TimestampText}" Width="80"/>
                    <DataGridTextColumn Header="프레임" Binding="{Binding FrameIndex}" Width="55"/>
                    <DataGridTextColumn Header="1투" Binding="{Binding Throw1}" Width="45"/>
                    <DataGridTextColumn Header="2투" Binding="{Binding Throw2}" Width="45"/>
                    <DataGridTextColumn Header="3투" Binding="{Binding Throw3}" Width="45"/>
                    <DataGridTextColumn Header="누적점수" Binding="{Binding CumulativeScore}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="점수판에 반영" Click="ApplyToBoard_Click" Margin="0,0,8,0"/>
            <Button Content="확인" Click="Confirm_Click"/>
            <Button Content="취소" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
