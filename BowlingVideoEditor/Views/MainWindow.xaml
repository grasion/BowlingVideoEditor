<Window x:Class="BowlingVideoEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="볼링 영상 편집기" Height="800" Width="1300"
        Background="#FF1E1E1E" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FF2D2D30" Height="45">
            <Button Content="📂 영상 열기" Click="OpenVideo_Click"/>
            <Button Content="✂️ 구간 자르기" Click="TrimVideo_Click"/>
            <Button Content="🔗 클립 합치기" Click="ConcatenateClips_Click"/>
            <Button Content="🎳 점수판 추가" Click="AddScoreboard_Click"/>
            <Button Content="🎱 볼링공 이미지" Click="AddBallImage_Click"/>
            <Button Content="📝 텍스트 추가" Click="AddText_Click"/>
            <Button Content="💾 내보내기" Click="Export_Click"/>
            <Separator Width="20"/>
            <Button Content="🔄 업데이트 확인" Click="CheckUpdate_Click"/>
            <Button Content="☕ 개발자에게 커피사주기" Click="BuyCoffee_Click"
                    Background="#FF6F4E37" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition x:Name="ScorePanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Video Player -->
            <Grid Grid.Column="0" x:Name="VideoContainer">
                <WindowsFormsHost x:Name="WfHost" ClipToBounds="True"/>
            </Grid>

            <!-- Clip List -->
            <Border Grid.Column="1" Background="#FF252526" CornerRadius="4" Margin="8,0,0,0" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="클립 목록" Foreground="#FFCCCCCC" FontSize="14" Margin="0,0,0,8"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="▲" Click="MoveClipUp_Click" Width="35"/>
                        <Button Content="▼" Click="MoveClipDown_Click" Width="35"/>
                        <Button Content="✕" Click="RemoveClip_Click" Width="35"/>
                    </StackPanel>
                    <ListBox x:Name="ClipListBox" Background="Transparent" Foreground="White"
                             BorderThickness="0" SelectionChanged="ClipListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="#FF999999">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:hh\:mm\:ss} ~ {1:hh\:mm\:ss}">
                                                <Binding Path="StartTime"/>
                                                <Binding Path="EndTime"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Score Panel -->
            <Border x:Name="ScorePanel" Grid.Column="2" Background="#FF252526" CornerRadius="4"
                    Margin="8,0,0,0" Padding="10" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🎳 점수판" Foreground="#FF007ACC"
                               FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="선수 이름" Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="PlayerNameBox" Text="Player 1"
                                 Background="#FF3E3E42" Foreground="White" BorderBrush="#FF555555"
                                 Padding="4,3" FontSize="13"/>
                    </StackPanel>
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <Grid x:Name="ScoreGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/><ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="50"/><ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="32"/><RowDefinition Height="32"/>
                                <RowDefinition Height="32"/><RowDefinition Height="32"/>
                                <RowDefinition Height="32"/><RowDefinition Height="32"/>
                                <RowDefinition Height="32"/><RowDefinition Height="32"/>
                                <RowDefinition Height="32"/><RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="F" Foreground="#FF888888" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="1투" Foreground="#FF888888" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="2투" Foreground="#FF888888" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="점수" Foreground="#FF888888" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="시간" Foreground="#FF888888" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ScrollViewer>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="10F 3투:" Foreground="#FFAAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="F10T3Box" Width="40" Background="#FF3E3E42" Foreground="White"
                                 BorderBrush="#FF555555" HorizontalContentAlignment="Center" FontSize="12"
                                 IsEnabled="False" LostFocus="ThrowBox_LostFocus"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Total:" Foreground="White" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TotalScoreText" Text="0" Foreground="#FF00CC6A" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- 점수판 위치/크기/글씨 조절 -->
                    <Border DockPanel.Dock="Top" BorderBrush="#FF444444" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,4,0,4">
                        <StackPanel>
                            <TextBlock Text="📐 점수판 설정" Foreground="#FF888888" FontSize="11" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="X위치" Foreground="#FFAAAAAA" FontSize="10" Width="35" VerticalAlignment="Center"/>
                                <Slider x:Name="ScorePosXSlider" Width="130" Minimum="0" Maximum="100" Value="3"
                                        ValueChanged="ScorePos_Changed"/>
                                <TextBlock x:Name="ScorePosXText" Text="3%" Foreground="#FF888888" FontSize="10" Width="30" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Y위치" Foreground="#FFAAAAAA" FontSize="10" Width="35" VerticalAlignment="Center"/>
                                <Slider x:Name="ScorePosYSlider" Width="130" Minimum="0" Maximum="100" Value="2"
                                        ValueChanged="ScorePos_Changed"/>
                                <TextBlock x:Name="ScorePosYText" Text="2%" Foreground="#FF888888" FontSize="10" Width="30" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="크기" Foreground="#FFAAAAAA" FontSize="10" Width="35" VerticalAlignment="Center"/>
                                <Slider x:Name="ScoreSizeSlider" Width="130" Minimum="50" Maximum="200" Value="100"
                                        ValueChanged="ScoreSize_Changed"/>
                                <TextBlock x:Name="ScoreSizeText" Text="100%" Foreground="#FF888888" FontSize="10" Width="35" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="글씨" Foreground="#FFAAAAAA" FontSize="10" Width="35" VerticalAlignment="Center"/>
                                <Slider x:Name="ScoreFontSlider" Width="130" Minimum="16" Maximum="48" Value="28"
                                        ValueChanged="ScoreFont_Changed"/>
                                <TextBlock x:Name="ScoreFontText" Text="28" Foreground="#FF888888" FontSize="10" Width="25" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button DockPanel.Dock="Bottom" Content="점수판 닫기" Click="CloseScorePanel_Click"
                            HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    <TextBlock/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                      Background="#FF3E3E42" ResizeDirection="Rows" ShowsPreview="True"/>

        <!-- Timeline Panel -->
        <Border Grid.Row="4" Background="#FF1A1A2E" BorderBrush="#FF333355" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Timeline Header: 시간 눈금자 -->
                <Border Grid.Row="0" Background="#FF252540" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="타임라인" Foreground="#FF888899" FontSize="10"
                                   VerticalAlignment="Center" Margin="8,0"/>
                        <Canvas x:Name="TimeRuler" Grid.Column="1" Background="Transparent"
                                ClipToBounds="True"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0">
                            <Button Content="🗑 선택 삭제" Click="DeleteSelectedClip_Click" FontSize="10" Padding="6,2"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tracks -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <!-- Track Labels -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#FF202038" BorderBrush="#FF333355" BorderThickness="0,0,1,1" Padding="6,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🎬 V1" Foreground="#FF44AAFF" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="영상" Foreground="#FF666688" FontSize="9"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Background="#FF202038" BorderBrush="#FF333355" BorderThickness="0,0,1,1" Padding="6,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🎳 S1" Foreground="#FF00CC6A" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="점수판" Foreground="#FF666688" FontSize="9"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" Background="#FF202038" BorderBrush="#FF333355" BorderThickness="0,0,1,0" Padding="6,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🔊 A1" Foreground="#FF44CC44" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="오디오" Foreground="#FF666688" FontSize="9"/>
                            </StackPanel>
                        </Border>

                        <!-- Video Track -->
                        <Canvas x:Name="VideoTrack" Grid.Row="0" Grid.Column="1"
                                Background="#FF1A1A2E" ClipToBounds="True"
                                MouseLeftButtonDown="Track_MouseDown"
                                MouseMove="Track_MouseMove"
                                MouseLeftButtonUp="Track_MouseUp"/>

                        <!-- Score Track -->
                        <Canvas x:Name="ScoreTrack" Grid.Row="1" Grid.Column="1"
                                Background="#FF1A1A28" ClipToBounds="True"/>

                        <!-- Audio Track (waveform) -->
                        <Canvas x:Name="AudioTrack" Grid.Row="2" Grid.Column="1"
                                Background="#FF151528" ClipToBounds="True"/>

                        <!-- Playhead (spans all tracks) -->
                        <Canvas x:Name="PlayheadCanvas" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                IsHitTestVisible="False" ClipToBounds="True">
                            <Line x:Name="PlayheadLine" Y1="0" Y2="200"
                                  Stroke="#FFFF4444" StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Overlay Edit Panel -->
        <Border Grid.Row="5" Background="#FF202030" Padding="6,4" x:Name="OverlayPanel"
                Visibility="Collapsed" BorderBrush="#FF333355" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 오버레이 목록 -->
                <ListBox x:Name="OverlayListBox" Grid.Column="0" Width="200"
                         Background="#FF1A1A28" Foreground="White" BorderThickness="0"
                         SelectionChanged="OverlayList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="White" FontSize="11">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}: {1}">
                                        <Binding Path="Type"/>
                                        <Binding Path="Content"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 선택된 오버레이 편집 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="X:" Foreground="#FFAAAAAA" FontSize="12" VerticalAlignment="Center"/>
                    <Slider x:Name="OvXSlider" Width="100" Minimum="0" Maximum="100" Value="50"
                            VerticalAlignment="Center" Margin="4,0,10,0" ValueChanged="OvSlider_Changed"/>
                    <TextBlock Text="Y:" Foreground="#FFAAAAAA" FontSize="12" VerticalAlignment="Center"/>
                    <Slider x:Name="OvYSlider" Width="100" Minimum="0" Maximum="100" Value="50"
                            VerticalAlignment="Center" Margin="4,0,10,0" ValueChanged="OvSlider_Changed"/>
                    <TextBlock Text="크기:" Foreground="#FFAAAAAA" FontSize="12" VerticalAlignment="Center"/>
                    <Slider x:Name="OvSizeSlider" Width="80" Minimum="10" Maximum="500" Value="100"
                            VerticalAlignment="Center" Margin="4,0,10,0" ValueChanged="OvSlider_Changed"/>
                    <Button Content="🗑 삭제" Click="DeleteOverlay_Click" FontSize="11" Padding="8,3"/>
                    <Button Content="닫기" Click="CloseOverlayPanel_Click" FontSize="11" Padding="8,3" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Playback Controls -->
        <Grid Grid.Row="6" Background="#FF2D2D30" Height="65">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <Button Content="⏮" Click="SeekBack_Click" Width="44" Height="34" FontSize="16"/>
                <Button x:Name="PlayPauseButton" Content="▶" Click="PlayPause_Click" Width="54" Height="34" FontSize="16"/>
                <Button Content="⏭" Click="SeekForward_Click" Width="44" Height="34" FontSize="16"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <Slider x:Name="TimelineSlider" Minimum="0" Maximum="1000"
                        ValueChanged="TimelineSlider_ValueChanged"
                        PreviewMouseLeftButtonDown="TimelineSlider_MouseDown"
                        PreviewMouseLeftButtonUp="TimelineSlider_MouseUp"/>
                <DockPanel>
                    <TextBlock x:Name="CurrentTimeText" Text="00:00:00" Foreground="#FFAAAAAA" FontSize="11"/>
                    <TextBlock x:Name="TotalTimeText" Text="00:00:00" Foreground="#FFAAAAAA" FontSize="11"
                               HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                </DockPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="시작:" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox x:Name="TrimStartBox" Width="65" Text="00:00:00"
                         Background="#FF3E3E42" Foreground="White" BorderBrush="#FF555555" VerticalContentAlignment="Center"/>
                <TextBlock Text="끝:" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="6,0,4,0"/>
                <TextBox x:Name="TrimEndBox" Width="65" Text="00:00:00"
                         Background="#FF3E3E42" Foreground="White" BorderBrush="#FF555555" VerticalContentAlignment="Center"/>
                <TextBlock Text="🔊" Foreground="#FFAAAAAA" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0"/>
                <Slider x:Name="VolumeSlider" Width="70" Minimum="0" Maximum="100" Value="100"
                        VerticalAlignment="Center" Margin="4,0,0,0" ValueChanged="VolumeSlider_ValueChanged"/>
                <TextBlock x:Name="VolumeText" Text="100%" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="4,0,0,0" Width="32"/>
            </StackPanel>
        </Grid>

        <StatusBar Grid.Row="7" Background="#FF007ACC" Height="25">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="준비" Foreground="White" FontSize="12"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="ProgressBar" Width="200" Height="14" Minimum="0" Maximum="100"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
